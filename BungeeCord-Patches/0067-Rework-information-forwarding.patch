+        }
+        try {
+            return ForwardingMode.valueOf(mode.toUpperCase(Locale.ROOT));
+        } catch (IllegalArgumentException ex) {
+            throw new IllegalArgumentException("Invalid forwarding_mode '" + mode
+                    + "', expected one of none, bungeecord_legacy, bungeeguard or velocity_modern", ex);
+        }
+    }
+
+    /**
+     * The secret is taken from the environment first, so that it can be shared with a
+     * Velocity proxy without either side having to own the file.
+     */
+    private byte[] readForwardingSecret(YamlConfig config) {
+        String env = System.getenv("VELOCITY_FORWARDING_SECRET");
+        if (env != null && !env.trim().isEmpty()) {
+            return env.trim().getBytes(StandardCharsets.UTF_8);
+        }
+        String secret = config.getString("forwarding_secret", "").trim();
+        if (!secret.isEmpty()) {
+            return secret.getBytes(StandardCharsets.UTF_8);
+        }
+        File file = new File(config.getString("forwarding_secret_file", "forwarding.secret"));
+        if (!file.isFile()) {
+            return new byte[0];
+        }
+        try {
+            return new String(Files.readAllBytes(file.toPath()), StandardCharsets.UTF_8).trim().getBytes(StandardCharsets.UTF_8);
+        } catch (IOException ex) {
+            throw new RuntimeException("Could not read the forwarding secret from " + file, ex);
+        }
