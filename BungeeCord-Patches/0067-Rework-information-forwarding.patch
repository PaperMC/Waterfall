diff --git a/proxy/src/main/java/io/github/waterfallmc/waterfall/forwarding/VelocityForwardingUtil.java b/proxy/src/main/java/io/github/waterfallmc/waterfall/forwarding/VelocityForwardingUtil.java
new file mode 100644
index 00000000..ee727073
--- /dev/null
+++ b/proxy/src/main/java/io/github/waterfallmc/waterfall/forwarding/VelocityForwardingUtil.java
@@ -0,0 +1,141 @@
+package io.github.waterfallmc.waterfall.forwarding;
+
+import com.google.common.base.Preconditions;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.ByteBufUtil;
+import io.netty.buffer.Unpooled;
+import net.md_5.bungee.protocol.DefinedPacket;
+import net.md_5.bungee.protocol.ProtocolConstants;
+import net.md_5.bungee.protocol.data.PlayerPublicKey;
+import net.md_5.bungee.protocol.data.Property;
+
+import javax.crypto.Mac;
+import javax.crypto.SecretKey;
+import javax.crypto.spec.SecretKeySpec;
+import java.security.InvalidKeyException;
+import java.security.NoSuchAlgorithmException;
+import java.util.UUID;
+
+public enum VelocityForwardingUtil {
+	;
+	public static final String VELOCITY_IP_FORWARDING_CHANNEL = "velocity:player_info";
+	public static final String MODERN_IP_FORWARDING_FAILURE = "Your server did not send a forwarding request to the proxy. Is it set up correctly?";
+
+	/**
+	 * Base payload: address, UUID, name and profile properties.
+	 */
+	public static final int MODERN_DEFAULT = 1;
+	/**
+	 * Adds a 1.19 ({@code GENERIC_V1}) player key.
+	 */
+	public static final int MODERN_WITH_KEY = 2;
+	/**
+	 * Adds a 1.19.1+ ({@code LINKED_V2}) player key plus the UUID it was signed for.
+	 */
+	public static final int MODERN_WITH_KEY_V2 = 3;
+	/**
+	 * 1.19.3+ session key model. Carries no key block.
+	 */
+	public static final int MODERN_LAZY_SESSION = 4;
+	public static final int MODERN_MAX_VERSION = MODERN_LAZY_SESSION;
+
+	/**
+	 * Reads the forwarding version the backend asked for out of a login plugin request.
+	 *
+	 * <p>The version is a single raw signed byte, not a VarInt. An absent or malformed
+	 * request is taken to mean version 1.</p>
+	 */
+	public static int readRequestedVersion(byte[] data) {
+		return (data == null || data.length != 1) ? MODERN_DEFAULT : data[0];
+	}
+
+	/**
+	 * Picks the version to actually send, given what the backend asked for, the client's
+	 * protocol version and whether it presented a key.
+	 *
+	 * <p>The result may be lower than the request: a key whose layout does not fit the
+	 * requested version is dropped rather than mis-encoded.</p>
+	 */
+	public static int getForwardingVersion(int requested, int protocolVersion, PlayerPublicKey playerKey) {
+		requested = Math.min(requested, MODERN_MAX_VERSION);
+		if (requested <= MODERN_DEFAULT) {
+			return MODERN_DEFAULT;
+		}
+
+		if (protocolVersion >= ProtocolConstants.MINECRAFT_1_19_3) {
+			return (requested >= MODERN_LAZY_SESSION) ? MODERN_LAZY_SESSION : MODERN_DEFAULT;
+		}
+
+		if (playerKey != null) {
+			// The key revision follows the client version: 1.19 signs a bare key (GENERIC_V1),
+			// 1.19.1 and 1.19.2 sign it against the player's UUID (LINKED_V2).
+			if (protocolVersion < ProtocolConstants.MINECRAFT_1_19_1) {
+				return MODERN_WITH_KEY;
+			}
+			return (requested >= MODERN_WITH_KEY_V2) ? MODERN_WITH_KEY_V2 : MODERN_DEFAULT;
+		}
+
+		return MODERN_DEFAULT;
+	}
+
+	/**
+	 * Builds the response body: a 32 byte HMAC-SHA256 tag over the payload, followed by the
+	 * payload itself.
+	 *
+	 * @param forwardingSecret the shared secret, used directly as the MAC key
+	 * @param version the negotiated version, from {@link #getForwardingVersion}
+	 * @param address the player's real address, without a port or an IPv6 scope suffix
+	 * @param name the player's username
+	 * @param playerUUID the player's authenticated UUID
+	 * @param properties the game profile properties, may be null
+	 * @param playerKey the player's key, required for versions 2 and 3
+	 * @param signerUuid the UUID the key was signed for, may be null
+	 */
+	public static byte[] writeForwardingData(byte[] forwardingSecret, int version, String address, String name, UUID playerUUID,
+			Property[] properties, PlayerPublicKey playerKey, UUID signerUuid) {
+		ByteBuf buf = Unpooled.buffer(2048);
+		try {
+			DefinedPacket.writeVarInt(version, buf);
+			DefinedPacket.writeString(address, buf);
+			DefinedPacket.writeUUID(playerUUID, buf);
+			DefinedPacket.writeString(name, buf);
+			DefinedPacket.writeProperties(properties, buf);
+
+			if (version > MODERN_DEFAULT && version < MODERN_LAZY_SESSION) {
+				Preconditions.checkArgument(playerKey != null, "Forwarding version %s requires a player key", version);
+				// Not writePublicKey: that writes a leading presence boolean, which the
+				// forwarding payload does not have.
+				buf.writeLong(playerKey.getExpiry());
+				DefinedPacket.writeArray(playerKey.getKey(), buf);
+				DefinedPacket.writeArray(playerKey.getSignature(), buf);
+
+				if (version >= MODERN_WITH_KEY_V2) {
+					if (signerUuid != null) {
+						buf.writeBoolean(true);
+						DefinedPacket.writeUUID(signerUuid, buf);
+					} else {
+						buf.writeBoolean(false);
+					}
+				}
+			}
+
+			SecretKey key = new SecretKeySpec(forwardingSecret, "HmacSHA256");
+			Mac mac = Mac.getInstance("HmacSHA256");
+			mac.init(key);
+			mac.update(buf.array(), buf.arrayOffset() + buf.readerIndex(), buf.readableBytes());
+			byte[] sig = mac.doFinal();
+
+			ByteBuf finished = Unpooled.wrappedBuffer(Unpooled.wrappedBuffer(sig), buf);
+			byte[] encoded = ByteBufUtil.getBytes(finished);
+			finished.release();
+			return encoded;
+		} catch (InvalidKeyException e) {
+			buf.release();
+			throw new RuntimeException("Unable to authenticate data", e);
+		} catch (NoSuchAlgorithmException e) {
+			// Should never happen
+			buf.release();
+			throw new AssertionError(e);
+		}
+	}
+}
