+    /**
+     * Reads the configured mode, falling back to whatever the legacy {@code ip_forward}
+     * option implies so that existing configurations keep working untouched.
+     */
+    private ForwardingMode readForwardingMode(YamlConfig config) {
+        // Written back as the default so the generated config names a concrete mode rather
+        // than an empty string, without changing what an existing configuration resolves to.
+        ForwardingMode derived = isIpForward() ? ForwardingMode.BUNGEECORD_LEGACY : ForwardingMode.NONE;
+        String mode = config.getString("forwarding_mode", derived.name().toLowerCase(Locale.ROOT)).trim();
+        if (mode.isEmpty()) {
