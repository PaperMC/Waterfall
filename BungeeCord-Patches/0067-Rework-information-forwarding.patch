+package io.github.waterfallmc.waterfall.forwarding;
+
+import static org.junit.jupiter.api.Assertions.*;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.UUID;
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+import net.md_5.bungee.protocol.DefinedPacket;
+import net.md_5.bungee.protocol.ProtocolConstants;
+import net.md_5.bungee.protocol.data.PlayerPublicKey;
+import net.md_5.bungee.protocol.data.Property;
+import org.junit.jupiter.api.Test;
+
+public class VelocityForwardingUtilTest
+{
+
+    private static final byte[] SECRET = "a-shared-secret".getBytes( StandardCharsets.UTF_8 );
+    private static final UUID UUID_ = UUID.fromString( "1bb815b4-1ced-3f90-babf-5307c13324f4" );
+    private static final UUID SIGNER = UUID.fromString( "00000000-0000-0000-0000-0000deadbeef" );
+    private static final PlayerPublicKey KEY = new PlayerPublicKey( 1234567890L, new byte[]
+    {
+        1, 2, 3
+    }, new byte[]
+    {
+        4, 5, 6, 7
+    } );
+
+    @Test
+    public void testRequestedVersion()
+    {
+        assertEquals( VelocityForwardingUtil.MODERN_DEFAULT, VelocityForwardingUtil.readRequestedVersion( null ) );
+        assertEquals( VelocityForwardingUtil.MODERN_DEFAULT, VelocityForwardingUtil.readRequestedVersion( new byte[ 0 ] ) );
+        // A raw signed byte, not a VarInt.
+        assertEquals( 4, VelocityForwardingUtil.readRequestedVersion( new byte[]
+        {
+            4
+        } ) );
+        // Anything that is not exactly one byte means "unspecified".
+        assertEquals( VelocityForwardingUtil.MODERN_DEFAULT, VelocityForwardingUtil.readRequestedVersion( new byte[]
+        {
+            4, 0
+        } ) );
+    }
+
+    @Test
+    public void testVersionNegotiation()
+    {
+        // Never above the request, and never above what we can encode.
+        assertEquals( 1, VelocityForwardingUtil.getForwardingVersion( 0, ProtocolConstants.MINECRAFT_1_21, null ) );
+        assertEquals( 1, VelocityForwardingUtil.getForwardingVersion( 1, ProtocolConstants.MINECRAFT_1_21, null ) );
+        assertEquals( 4, VelocityForwardingUtil.getForwardingVersion( 99, ProtocolConstants.MINECRAFT_1_21, null ) );
+
+        // 1.19.3 and up: the session key model, or nothing.
+        assertEquals( 4, VelocityForwardingUtil.getForwardingVersion( 4, ProtocolConstants.MINECRAFT_1_19_3, null ) );
+        assertEquals( 1, VelocityForwardingUtil.getForwardingVersion( 3, ProtocolConstants.MINECRAFT_1_19_3, null ) );
+        assertEquals( 1, VelocityForwardingUtil.getForwardingVersion( 2, ProtocolConstants.MINECRAFT_1_19_3, null ) );
+
+        // 1.19 signs a bare key.
+        assertEquals( 2, VelocityForwardingUtil.getForwardingVersion( 4, ProtocolConstants.MINECRAFT_1_19, KEY ) );
+        assertEquals( 2, VelocityForwardingUtil.getForwardingVersion( 2, ProtocolConstants.MINECRAFT_1_19, KEY ) );
+
+        // 1.19.1 and 1.19.2 sign it against the player's UUID, which version 2 cannot carry,
+        // so the key is dropped rather than mis-encoded.
+        assertEquals( 3, VelocityForwardingUtil.getForwardingVersion( 4, ProtocolConstants.MINECRAFT_1_19_1, KEY ) );
+        assertEquals( 3, VelocityForwardingUtil.getForwardingVersion( 3, ProtocolConstants.MINECRAFT_1_19_1, KEY ) );
+        assertEquals( 1, VelocityForwardingUtil.getForwardingVersion( 2, ProtocolConstants.MINECRAFT_1_19_1, KEY ) );
+
+        // No key, so nothing to describe.
+        assertEquals( 1, VelocityForwardingUtil.getForwardingVersion( 4, ProtocolConstants.MINECRAFT_1_19_1, null ) );
+    }
+
+    @Test
+    public void testSignature() throws Exception
+    {
+        byte[] data = VelocityForwardingUtil.writeForwardingData( SECRET, 1, "127.0.0.1", "Probe", UUID_, null, null, null );
+
+        byte[] signature = new byte[ 32 ];
+        System.arraycopy( data, 0, signature, 0, 32 );
+        byte[] payload = new byte[ data.length - 32 ];
+        System.arraycopy( data, 32, payload, 0, payload.length );
+
+        // The tag covers the payload only, with no framing.
+        Mac mac = Mac.getInstance( "HmacSHA256" );
+        mac.init( new SecretKeySpec( SECRET, "HmacSHA256" ) );
+        assertTrue( MessageDigest.isEqual( signature, mac.doFinal( payload ) ) );
+    }
+
+    @Test
+    public void testBasePayload()
+    {
+        Property[] properties = new Property[]
+        {
+            new Property( "textures", "value", "signature" ),
+            new Property( "unsigned", "value" )
+        };
+        ByteBuf payload = payloadOf( VelocityForwardingUtil.writeForwardingData( SECRET, 1, "127.0.0.1", "Probe", UUID_, properties, null, null ) );
+
+        assertEquals( 1, DefinedPacket.readVarInt( payload ) );
+        assertEquals( "127.0.0.1", DefinedPacket.readString( payload ) );
+        assertEquals( UUID_, DefinedPacket.readUUID( payload ) );
+        assertEquals( "Probe", DefinedPacket.readString( payload ) );
+        assertEquals( 2, DefinedPacket.readVarInt( payload ) );
+        assertEquals( "textures", DefinedPacket.readString( payload ) );
+        assertEquals( "value", DefinedPacket.readString( payload ) );
+        assertTrue( payload.readBoolean() );
+        assertEquals( "signature", DefinedPacket.readString( payload ) );
+        assertEquals( "unsigned", DefinedPacket.readString( payload ) );
+        assertEquals( "value", DefinedPacket.readString( payload ) );
+        assertFalse( payload.readBoolean() );
+        assertFalse( payload.isReadable() );
+    }
+
+    @Test
+    public void testNullPropertiesAreAnEmptyList()
+    {
+        // An offline mode proxy has no login profile at all.
+        ByteBuf payload = payloadOf( VelocityForwardingUtil.writeForwardingData( SECRET, 1, "127.0.0.1", "Probe", UUID_, null, null, null ) );
+        skipBase( payload, 1 );
+        assertFalse( payload.isReadable() );
+    }
+
+    @Test
+    public void testKeyPayload()
+    {
+        ByteBuf payload = payloadOf( VelocityForwardingUtil.writeForwardingData( SECRET, 2, "127.0.0.1", "Probe", UUID_, null, KEY, SIGNER ) );
+        skipBase( payload, 2 );
+        // The key block has no presence boolean, unlike DefinedPacket#writePublicKey.
+        assertEquals( KEY.getExpiry(), payload.readLong() );
+        assertArrayEquals( KEY.getKey(), DefinedPacket.readArray( payload ) );
+        assertArrayEquals( KEY.getSignature(), DefinedPacket.readArray( payload ) );
+        // Version 2 stops before the signer UUID even when we know it.
+        assertFalse( payload.isReadable() );
+    }
+
+    @Test
+    public void testKeyPayloadWithSignerUuid()
+    {
+        ByteBuf payload = payloadOf( VelocityForwardingUtil.writeForwardingData( SECRET, 3, "127.0.0.1", "Probe", UUID_, null, KEY, SIGNER ) );
+        skipBase( payload, 3 );
+        assertEquals( KEY.getExpiry(), payload.readLong() );
+        assertArrayEquals( KEY.getKey(), DefinedPacket.readArray( payload ) );
+        assertArrayEquals( KEY.getSignature(), DefinedPacket.readArray( payload ) );
+        assertTrue( payload.readBoolean() );
+        assertEquals( SIGNER, DefinedPacket.readUUID( payload ) );
+        assertFalse( payload.isReadable() );
+
+        // An offline player has no signer to link the key to.
+        payload = payloadOf( VelocityForwardingUtil.writeForwardingData( SECRET, 3, "127.0.0.1", "Probe", UUID_, null, KEY, null ) );
+        skipBase( payload, 3 );
+        payload.readLong();
+        DefinedPacket.readArray( payload );
+        DefinedPacket.readArray( payload );
+        assertFalse( payload.readBoolean() );
+        assertFalse( payload.isReadable() );
+    }
+
+    @Test
+    public void testLazySessionCarriesNoKey()
+    {
+        ByteBuf payload = payloadOf( VelocityForwardingUtil.writeForwardingData( SECRET, 4, "127.0.0.1", "Probe", UUID_, null, KEY, SIGNER ) );
+        skipBase( payload, 4 );
+        assertFalse( payload.isReadable() );
+    }
+
+    @Test
+    public void testKeyIsRequiredWhenTheVersionSaysSo()
+    {
+        assertThrows( IllegalArgumentException.class,
+                () -> VelocityForwardingUtil.writeForwardingData( SECRET, 3, "127.0.0.1", "Probe", UUID_, null, null, SIGNER ) );
+    }
+
+    private static ByteBuf payloadOf(byte[] data)
+    {
+        return Unpooled.wrappedBuffer( data, 32, data.length - 32 );
+    }
+
+    private static void skipBase(ByteBuf payload, int expectedVersion)
+    {
+        assertEquals( expectedVersion, DefinedPacket.readVarInt( payload ) );
+        DefinedPacket.readString( payload );
+        DefinedPacket.readUUID( payload );
+        DefinedPacket.readString( payload );
+        assertEquals( 0, DefinedPacket.readVarInt( payload ) );
+    }
+}
